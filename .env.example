# Domain resmi, contoh: https://ruangsejahtera.or.id
NEXT_PUBLIC_SITE_URL=

# Hanya isi dengan data resmi yayasan.
NEXT_PUBLIC_OFFICIAL_ADDRESS=
NEXT_PUBLIC_OFFICIAL_WHATSAPP=
NEXT_PUBLIC_OFFICIAL_EMAIL=
NEXT_PUBLIC_OFFICIAL_MAP_URL=

# Akun media sosial resmi. Kosongkan jika belum disahkan.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Admin bootstrap hanya untuk local/preview. Kode memblokir mode ini pada VERCEL_ENV=production.
# ADMIN_BOOTSTRAP_KEY_SHA256 berisi SHA-256 hex dari kunci akses, bukan kunci plaintext.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_ROLE=super_admin
ADMIN_BOOTSTRAP_KEY_SHA256=
ADMIN_SESSION_SECRET=

# Backend tulis CMS production belum diaktifkan pada V2.
# Registry baca ada di content/cms/*.json dan hanya record status published yang tampil publik.

# Kredensial CMS, storage, database, identity provider, dan payment gateway TIDAK disimpan di repository.
# Tambahkan melalui secret manager pada environment deployment.
