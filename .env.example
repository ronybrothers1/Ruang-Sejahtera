# Domain resmi, contoh: https://ruangsejahtera.or.id
NEXT_PUBLIC_SITE_URL=

# Hanya isi dengan data resmi yayasan.
NEXT_PUBLIC_OFFICIAL_ADDRESS=
NEXT_PUBLIC_OFFICIAL_WHATSAPP=
NEXT_PUBLIC_OFFICIAL_EMAIL=
NEXT_PUBLIC_OFFICIAL_MAP_URL=

# Akun media sosial resmi. Kosongkan jika belum disahkan.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Identity provider production (Clerk). Tambahkan melalui Vercel Marketplace,
# jangan commit nilai aktual ke repository.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/masuk
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/daftar
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/akun
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/akun

# PostgreSQL production (Neon via Vercel Marketplace).
DATABASE_URL=

# Hanya diperlukan saat menjalankan seed terkontrol. Jangan jadikan public env.
INITIAL_SUPER_ADMIN_NAME=
INITIAL_SUPER_ADMIN_EMAIL=

# Media dan notifikasi fase berikutnya.
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=

# Login sederhana Super Admin untuk tahap pembangunan.
# ADMIN_BOOTSTRAP_KEY_SHA256 berisi SHA-256 hex dari kunci akses, bukan kunci plaintext.
# Jika dipakai pada Vercel Production, ADMIN_BOOTSTRAP_ALLOW_PRODUCTION harus true
# dan ADMIN_BOOTSTRAP_PRODUCTION_CONFIRMATION harus bernilai persis:
# I_UNDERSTAND_BOOTSTRAP_RISK
# Matikan kedua flag sebelum go-live dan gunakan autentikasi final.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_ALLOW_PRODUCTION=false
ADMIN_BOOTSTRAP_PRODUCTION_CONFIRMATION=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_ROLE=super_admin
ADMIN_BOOTSTRAP_KEY_SHA256=
ADMIN_SESSION_SECRET=

# Mitigasi sementara ketika Clerk MFA belum diaktifkan.
# Default MFA tetap fail-closed jika login sederhana tidak dikonfigurasi.
ADMIN_CONTROL_PLANE_MODE=mfa
ADMIN_CONTROL_PLANE_APPROVAL_KEY_SHA256=
ADMIN_CONTROL_PLANE_APPROVAL_SECRET=

# Backend tulis CMS masih fail-closed sampai adapter PostgreSQL fase konten aktif.
# Registry baca sementara ada di content/cms/*.json dan hanya status published yang tampil publik.

# Kredensial CMS, storage, database, identity provider, dan payment gateway TIDAK disimpan di repository.
# Tambahkan melalui secret manager pada environment deployment.
