# Domain resmi, contoh: https://www.ruangsejahtera.web.id
NEXT_PUBLIC_SITE_URL=

# Hanya isi dengan data resmi yayasan.
NEXT_PUBLIC_OFFICIAL_ADDRESS=
NEXT_PUBLIC_OFFICIAL_WHATSAPP=
NEXT_PUBLIC_OFFICIAL_EMAIL=
NEXT_PUBLIC_OFFICIAL_MAP_URL=

# Akun media sosial resmi. Kosongkan jika belum disahkan.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Identity provider production (Clerk). Tambahkan melalui Vercel environment variables,
# jangan commit nilai aktual ke repository.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/masuk
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/daftar
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/akun
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/akun

# PostgreSQL production (Neon).
DATABASE_URL=

# Hanya diperlukan saat menjalankan seed Super Admin pertama kali.
# Tidak berisi password. Password dikelola oleh Clerk.
INITIAL_SUPER_ADMIN_NAME=
INITIAL_SUPER_ADMIN_EMAIL=

# Media dan notifikasi fase berikutnya.
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
TRANSACTIONAL_EMAIL_FROM=

# Tidak ada ADMIN_BOOTSTRAP_KEY, approval key, atau MFA gate tambahan.
# Semua role masuk melalui /masuk menggunakan akun Clerk masing-masing.

# Backend tulis CMS masih fail-closed sampai adapter PostgreSQL fase konten aktif.
# Registry baca sementara ada di content/cms/*.json dan hanya status published yang tampil publik.

# Kredensial database, identity provider, storage, email, dan payment gateway
# TIDAK disimpan di repository. Simpan melalui environment variables Vercel.
